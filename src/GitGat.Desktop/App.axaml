<Application
    x:Class="GitGat.Desktop.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:suki="clr-namespace:SukiUI;assembly=SukiUI"
    RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme />
        <suki:SukiTheme />
        <StyleInclude Source="avares://GitGat/Styles/GitGatTheme.axaml" />
    </Application.Styles>
</Application>
