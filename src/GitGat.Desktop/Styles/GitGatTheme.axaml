<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <SolidColorBrush x:Key="GitGatBackgroundBrush" Color="#0B0F14" />
        <SolidColorBrush x:Key="GitGatSidebarBrush" Color="#0F151C" />
        <SolidColorBrush x:Key="GitGatSurfaceBrush" Color="#141B23" />
        <SolidColorBrush x:Key="GitGatSurfaceRaisedBrush" Color="#19232E" />
        <SolidColorBrush x:Key="GitGatSurfaceHoverBrush" Color="#202C38" />
        <SolidColorBrush x:Key="GitGatBorderBrush" Color="#283543" />
        <SolidColorBrush x:Key="GitGatTextBrush" Color="#F2F6FA" />
        <SolidColorBrush x:Key="GitGatMutedBrush" Color="#95A4B4" />
        <SolidColorBrush x:Key="GitGatAccentBrush" Color="#68D7C5" />
        <SolidColorBrush x:Key="GitGatAccentSoftBrush" Color="#183D39" />
        <SolidColorBrush x:Key="GitGatDangerBrush" Color="#FF7A85" />
        <SolidColorBrush x:Key="GitGatWarningBrush" Color="#F4C95D" />
        <SolidColorBrush x:Key="GitGatSuccessBrush" Color="#77D69A" />
    </Styles.Resources>

    <Style Selector="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource GitGatTextBrush}" />
    </Style>

    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource GitGatMutedBrush}" />
    </Style>

    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource GitGatSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GitGatBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style Selector="Border.toolbar">
        <Setter Property="Background" Value="{DynamicResource GitGatSurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GitGatBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <Style Selector="Button">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource GitGatSurfaceHoverBrush}" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource GitGatAccentBrush}" />
        <Setter Property="Foreground" Value="#07110F" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Foreground" Value="{DynamicResource GitGatDangerBrush}" />
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource GitGatBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Background" Value="{DynamicResource GitGatSurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GitGatBorderBrush}" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="TabControl">
        <Setter Property="Background" Value="Transparent" />
    </Style>
</Styles>
