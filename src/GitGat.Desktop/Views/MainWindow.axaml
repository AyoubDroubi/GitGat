<suki:SukiWindow
    x:Class="GitGat.Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
    x:CompileBindings="False"
    Title="GitGat"
    Width="1500"
    Height="920"
    MinWidth="1080"
    MinHeight="720"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource GitGatBackgroundBrush}">

    <Grid ColumnDefinitions="290,*" RowDefinitions="*,Auto">
        <Border
            Grid.RowSpan="2"
            Background="{DynamicResource GitGatSidebarBrush}"
            BorderBrush="{DynamicResource GitGatBorderBrush}"
            BorderThickness="0,0,1,0">
            <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto">
                <StackPanel Spacing="3">
                    <TextBlock Classes="h1" Text="GitGat" />
                    <TextBlock Classes="muted" FontSize="12" Text="A calm desktop Git workspace" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,20,0,12" Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBox
                            PlaceholderText="Search repositories…"
                            Text="{Binding RepositorySearch, Mode=TwoWay}" />
                        <Button
                            Grid.Column="1"
                            Classes="ghost"
                            Command="{Binding SearchRepositoriesCommand}"
                            Content="Search" />
                    </Grid>
                    <Button
                        Classes="primary"
                        Click="OpenRepositoryClicked"
                        Content="+ Open local repository" />
                </StackPanel>

                <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto">
                    <TextBlock
                        Margin="4,0,0,8"
                        Classes="muted"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Text="REPOSITORIES" />

                    <ListBox
                        Grid.Row="1"
                        ItemsSource="{Binding Repositories}"
                        SelectedItem="{Binding ActiveRepository, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,6" ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                        <TextBlock
                                            Classes="muted"
                                            FontSize="11"
                                            Text="{Binding LocalPath}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Text="{Binding IsFavorite, StringFormat='★ {0}'}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                        <Button
                            Margin="0,0,6,6"
                            Classes="ghost"
                            Command="{Binding OpenRecentCommand}"
                            CommandParameter="{Binding ActiveRepository}"
                            Content="Open" />
                        <Button
                            Margin="0,0,6,6"
                            Classes="ghost"
                            Command="{Binding ToggleFavoriteCommand}"
                            CommandParameter="{Binding ActiveRepository}"
                            Content="Favorite" />
                        <Button
                            Margin="0,0,0,6"
                            Classes="danger"
                            Command="{Binding RemoveRepositoryCommand}"
                            CommandParameter="{Binding ActiveRepository}"
                            Content="Forget" />
                    </WrapPanel>
                </Grid>

                <StackPanel Grid.Row="3" Spacing="4">
                    <TextBlock Classes="muted" FontSize="11" Text="{Binding GitVersion}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" FontSize="11" Text="{Binding GitHubStatus}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="24,20,24,12" RowDefinitions="Auto,Auto,*">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                    <TextBlock
                        Classes="h1"
                        Text="{Binding ActiveRepository.Name, FallbackValue='Workspace'}" />
                    <TextBlock Classes="muted" Text="{Binding StatusSummary}" />
                </StackPanel>

                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button
                        Margin="0,0,6,0"
                        Classes="ghost"
                        Command="{Binding RefreshRepositoryCommand}"
                        Content="Refresh" />
                    <Button
                        Margin="0,0,6,0"
                        Classes="ghost"
                        Command="{Binding FetchCommand}"
                        Content="Fetch" />
                    <Button
                        Margin="0,0,6,0"
                        Classes="ghost"
                        Command="{Binding PullCommand}"
                        Content="Pull" />
                    <Button
                        Classes="primary"
                        Command="{Binding PushCommand}"
                        Content="Push" />
                </WrapPanel>
            </Grid>

            <Border Grid.Row="1" Margin="0,16,0,12" Classes="toolbar">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock
                        VerticalAlignment="Center"
                        Classes="muted"
                        Text="{Binding OperationStatus}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Classes="muted"
                        Text="{Binding IsBusy, StringFormat='Busy: {0}'}" />
                </Grid>
            </Border>

            <TabControl Grid.Row="2">
                <TabItem Header="Overview">
                    <ScrollViewer>
                        <StackPanel Margin="4,14" Spacing="14">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                                <Border Classes="card">
                                    <StackPanel Spacing="10">
                                        <TextBlock Classes="h2" Text="Clone repository" />
                                        <TextBox PlaceholderText="https://github.com/owner/repo.git" Text="{Binding CloneUrl, Mode=TwoWay}" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBox PlaceholderText="Empty destination folder" Text="{Binding CloneDestination, Mode=TwoWay}" />
                                            <Button Grid.Column="1" Classes="ghost" Click="PickCloneDestinationClicked" Content="Browse" />
                                        </Grid>
                                        <Button Classes="primary" Command="{Binding CloneRepositoryCommand}" Content="Clone &amp; open" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Classes="card">
                                    <StackPanel Spacing="10">
                                        <TextBlock Classes="h2" Text="GitHub connection" />
                                        <TextBlock Classes="muted" Text="{Binding GitHubStatus}" TextWrapping="Wrap" />
                                        <WrapPanel>
                                            <Button Margin="0,0,6,0" Classes="primary" Command="{Binding ConnectGitHubCommand}" Content="Connect" />
                                            <Button Margin="0,0,6,0" Classes="ghost" Command="{Binding RefreshGitHubCommand}" Content="Refresh" />
                                            <Button Classes="danger" Command="{Binding DisconnectGitHubCommand}" Content="Disconnect" />
                                        </WrapPanel>
                                        <TextBlock Classes="muted" FontSize="11" Text="Credentials stay in GitHub CLI / OS credential storage, not GitGat files or SQLite." TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="h2" Text="Notifications" />
                                        <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Notifications.Count, StringFormat='{}{0} items'}" />
                                    </Grid>
                                    <ListBox MaxHeight="250" ItemsSource="{Binding Notifications}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="2,5" Spacing="2">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Subject}" />
                                                    <TextBlock Classes="muted" FontSize="11" Text="{Binding Repository}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Changes">
                    <Grid Margin="4,14" ColumnDefinitions="360,*" ColumnSpacing="14">
                        <Border Classes="card">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <TextBlock Classes="h2" Text="Working tree" />
                                <ListBox
                                    Grid.Row="1"
                                    Margin="0,10"
                                    ItemsSource="{Binding Changes}"
                                    SelectedItem="{Binding SelectedChange, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,5" ColumnDefinitions="Auto,*">
                                                <TextBlock Width="72" Classes="muted" Text="{Binding Kind}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <WrapPanel Grid.Row="2">
                                    <Button Margin="0,0,6,6" Classes="ghost" Command="{Binding ShowDiffCommand}" Content="Diff" />
                                    <Button Margin="0,0,6,6" Classes="primary" Command="{Binding StageSelectedCommand}" Content="Stage" />
                                    <Button Margin="0,0,0,6" Classes="ghost" Command="{Binding UnstageSelectedCommand}" Content="Unstage" />
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="1" RowDefinitions="*,Auto,Auto" RowSpacing="12">
                            <Border Classes="card">
                                <Grid RowDefinitions="Auto,*">
                                    <TextBlock Classes="h2" Text="Diff" />
                                    <TextBox
                                        Grid.Row="1"
                                        Margin="0,10,0,0"
                                        AcceptsReturn="True"
                                        IsReadOnly="True"
                                        FontFamily="Cascadia Mono, Consolas, monospace"
                                        FontSize="12"
                                        Text="{Binding DiffText}"
                                        TextWrapping="NoWrap"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Classes="card">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <TextBox PlaceholderText="Commit message" Text="{Binding CommitMessage, Mode=TwoWay}" />
                                    <Button Grid.Column="1" Classes="primary" Command="{Binding CommitCommand}" Content="Commit staged" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Classes="card">
                                <StackPanel Spacing="8">
                                    <TextBlock Foreground="{DynamicResource GitGatDangerBrush}" FontWeight="SemiBold" Text="Discard tracked change" />
                                    <TextBlock Classes="muted" FontSize="11" Text="GitGat never silently removes untracked files. Type the exact selected path to confirm." />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <TextBox Text="{Binding DiscardConfirmation, Mode=TwoWay}" PlaceholderText="Exact file path" />
                                        <Button Grid.Column="1" Classes="danger" Command="{Binding DiscardSelectedCommand}" Content="Discard" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="Branches">
                    <Grid Margin="4,14" ColumnDefinitions="*,360" ColumnSpacing="14">
                        <Border Classes="card">
                            <Grid RowDefinitions="Auto,*">
                                <TextBlock Classes="h2" Text="Local &amp; remote branches" />
                                <ListBox Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,6" ColumnDefinitions="*,Auto">
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                    <TextBlock Classes="muted" FontSize="11" Text="{Binding Upstream}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Ahead, StringFormat='↑{0}'}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="h2" Text="Branch actions" />
                                <Button Classes="primary" Command="{Binding CheckoutBranchCommand}" Content="Switch selected" />
                                <TextBox PlaceholderText="new-branch-name" Text="{Binding NewBranchName, Mode=TwoWay}" />
                                <Button Classes="ghost" Command="{Binding CreateBranchCommand}" Content="Create &amp; switch" />
                                <Button Classes="danger" Command="{Binding DeleteBranchCommand}" Content="Delete selected (merged only)" />
                                <TextBlock Classes="muted" FontSize="11" Text="Switching is blocked while the working tree is dirty. Branch deletion uses Git's safe -d behavior." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="History">
                    <Grid Margin="4,14" ColumnDefinitions="420,*" ColumnSpacing="14">
                        <Border Classes="card">
                            <Grid RowDefinitions="Auto,*">
                                <TextBlock Classes="h2" Text="Recent commits" />
                                <ListBox Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedCommit, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,6">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Subject}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Classes="muted" FontSize="11" Text="{Binding ShortSha}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Classes="card">
                            <Grid RowDefinitions="Auto,Auto,*">
                                <TextBlock Classes="h2" Text="Commit detail" />
                                <Button Grid.Row="1" Margin="0,10,0,8" HorizontalAlignment="Left" Classes="ghost" Command="{Binding ShowCommitCommand}" Content="Load selected" />
                                <TextBox Grid.Row="2" AcceptsReturn="True" IsReadOnly="True" Text="{Binding CommitDetailText}" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Pull Requests">
                    <Grid Margin="4,14" ColumnDefinitions="400,*" ColumnSpacing="14">
                        <Border Classes="card">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <TextBlock Classes="h2" Text="Open pull requests" />
                                <ListBox Grid.Row="1" Margin="0,10" ItemsSource="{Binding PullRequests}" SelectedItem="{Binding SelectedPullRequest, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,6">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Classes="muted" FontSize="11" Text="{Binding Author}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Grid.Row="2" Classes="primary" Command="{Binding OpenPullRequestCommand}" CommandParameter="{Binding SelectedPullRequest}" Content="Open selected" />
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Column="1">
                            <StackPanel Spacing="12">
                                <Border Classes="card">
                                    <StackPanel Spacing="10">
                                        <TextBlock Classes="h2" Text="Review" />
                                        <TextBox AcceptsReturn="True" MinHeight="150" IsReadOnly="True" Text="{Binding PullRequestDetailText}" />
                                        <ItemsControl ItemsSource="{Binding ChangedPullRequestFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate><TextBlock Classes="mono muted" Text="{Binding}" /></DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBox AcceptsReturn="True" MinHeight="70" PlaceholderText="Review comment" Text="{Binding PullRequestComment, Mode=TwoWay}" />
                                        <WrapPanel>
                                            <Button Margin="0,0,6,6" Classes="ghost" Command="{Binding CommentPullRequestCommand}" Content="Comment" />
                                            <Button Margin="0,0,6,6" Classes="primary" Command="{Binding ApprovePullRequestCommand}" Content="Approve" />
                                            <Button Margin="0,0,6,6" Classes="danger" Command="{Binding RequestChangesCommand}" Content="Request changes" />
                                            <Button Classes="ghost" Command="{Binding MergePullRequestCommand}" Content="Merge if allowed" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Classes="card">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="h2" Text="Create pull request" />
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <TextBox PlaceholderText="head branch" Text="{Binding PullRequestHead, Mode=TwoWay}" />
                                            <TextBox Grid.Column="1" PlaceholderText="base branch" Text="{Binding PullRequestBase, Mode=TwoWay}" />
                                        </Grid>
                                        <TextBox PlaceholderText="Title" Text="{Binding PullRequestTitle, Mode=TwoWay}" />
                                        <TextBox AcceptsReturn="True" MinHeight="70" PlaceholderText="Description" Text="{Binding PullRequestBody, Mode=TwoWay}" />
                                        <Button Classes="primary" HorizontalAlignment="Left" Command="{Binding CreatePullRequestCommand}" Content="Create PR" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem Header="Locks">
                    <Grid Margin="4,14" ColumnDefinitions="*,360" ColumnSpacing="14">
                        <Border Classes="card">
                            <Grid RowDefinitions="Auto,*">
                                <TextBlock Classes="h2" Text="Git LFS locks" />
                                <ListBox Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Locks}" SelectedItem="{Binding SelectedLock, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,6" ColumnDefinitions="*,Auto">
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Path}" />
                                                    <TextBlock Classes="muted" FontSize="11" Text="{Binding Owner}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding IsMine, StringFormat='Mine: {0}'}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="h2" Text="Lock controls" />
                                <Button Classes="primary" Command="{Binding LockSelectedCommand}" Content="Lock selected changed file" />
                                <Button Classes="ghost" Command="{Binding UnlockSelectedCommand}" Content="Unlock selected lock" />
                                <TextBox PlaceholderText="*.uasset" Text="{Binding LfsPattern, Mode=TwoWay}" />
                                <Button Classes="ghost" Command="{Binding ConfigureLockablePatternCommand}" Content="Mark pattern lockable" />
                                <TextBlock Classes="muted" FontSize="11" Text="Force unlock is intentionally not exposed as a default UI action." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Actions">
                    <Grid Margin="4,14" ColumnDefinitions="420,*" ColumnSpacing="14">
                        <Border Classes="card">
                            <Grid RowDefinitions="Auto,*">
                                <TextBlock Classes="h2" Text="Workflow runs" />
                                <ListBox Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding WorkflowRuns}" SelectedItem="{Binding SelectedWorkflowRun, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,6">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                <TextBlock Classes="muted" FontSize="11" Text="{Binding Status}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Classes="card">
                            <Grid RowDefinitions="Auto,Auto,*">
                                <WrapPanel>
                                    <Button Margin="0,0,6,0" Classes="ghost" Command="{Binding ShowFailedWorkflowLogCommand}" Content="Failed log" />
                                    <Button Classes="primary" Command="{Binding RerunFailedWorkflowCommand}" Content="Rerun failed jobs" />
                                </WrapPanel>
                                <TextBlock Grid.Row="1" Margin="0,10,0,6" Classes="muted" Text="Large logs are loaded only on demand." />
                                <TextBox Grid.Row="2" AcceptsReturn="True" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" Text="{Binding WorkflowLogText}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="My Work">
                    <Border Margin="4,14" Classes="card">
                        <Grid RowDefinitions="Auto,*">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="h2" Text="My Work" />
                                    <TextBlock Classes="muted" Text="Unread GitHub notifications and relevant pull-request work across known repositories." />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="primary" Command="{Binding RefreshMyWorkCommand}" Content="Refresh" />
                            </Grid>
                            <ListBox Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding MyWorkItems}" />
                        </Grid>
                    </Border>
                </TabItem>

                <TabItem Header="Workspaces">
                    <Grid Margin="4,14" ColumnDefinitions="420,*" ColumnSpacing="14">
                        <Border Classes="card">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <TextBlock Classes="h2" Text="Saved workspaces" />
                                <ListBox Grid.Row="1" Margin="0,10" ItemsSource="{Binding Workspaces}" SelectedItem="{Binding SelectedWorkspace, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,6">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                <TextBlock Classes="muted" FontSize="11" Text="{Binding RepositoryIds.Count, StringFormat='{}{0} repositories'}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Grid.Row="2" Classes="danger" Command="{Binding DeleteWorkspaceCommand}" Content="Delete selected workspace" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="h2" Text="Workspace membership" />
                                <TextBox PlaceholderText="Workspace name" Text="{Binding WorkspaceName, Mode=TwoWay}" />
                                <Button Classes="primary" Command="{Binding CreateWorkspaceCommand}" Content="Create workspace with active repository" />
                                <Button Classes="ghost" Command="{Binding AddRepositoryToWorkspaceCommand}" Content="Add active repository to selected" />
                                <Button Classes="ghost" Command="{Binding RemoveRepositoryFromWorkspaceCommand}" Content="Remove active repository from selected" />
                                <TextBlock Classes="muted" FontSize="11" Text="Workspace membership is local GitGat metadata and never edits repository configuration." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Advanced">
                    <ScrollViewer>
                        <StackPanel Margin="4,14" Spacing="14">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                                <Border Classes="card">
                                    <StackPanel Spacing="10">
                                        <TextBlock Classes="h2" Text="Stashes" />
                                        <ListBox MaxHeight="180" ItemsSource="{Binding Stashes}" SelectedItem="{Binding SelectedStash, Mode=TwoWay}" />
                                        <WrapPanel>
                                            <Button Margin="0,0,6,0" Classes="primary" Command="{Binding StashAllCommand}" Content="Stash all" />
                                            <Button Classes="ghost" Command="{Binding ApplyStashCommand}" Content="Apply selected" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Classes="card">
                                    <StackPanel Spacing="10">
                                        <TextBlock Classes="h2" Text="Recovery" />
                                        <TextBlock Classes="muted" Text="{Binding CurrentRepositoryStatus.Operation, StringFormat='In-progress operation: {0}'}" />
                                        <TextBox PlaceholderText="Type ABORT" Text="{Binding AdvancedConfirmation, Mode=TwoWay}" />
                                        <Button Classes="danger" Command="{Binding AbortOperationCommand}" Content="Abort current Git operation" />
                                        <TextBlock Classes="muted" FontSize="11" Text="Only merge, rebase and cherry-pick aborts are supported here. Recovery claims are based on Git metadata." TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                                <Border Classes="card">
                                    <StackPanel Spacing="10">
                                        <TextBlock Classes="h2" Text="Worktrees" />
                                        <ListBox MaxHeight="160" ItemsSource="{Binding Worktrees}" SelectedItem="{Binding SelectedWorktree, Mode=TwoWay}" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBox PlaceholderText="Worktree directory" Text="{Binding WorktreePath, Mode=TwoWay}" />
                                            <Button Grid.Column="1" Classes="ghost" Click="PickWorktreePathClicked" Content="Browse" />
                                        </Grid>
                                        <TextBox PlaceholderText="Existing branch" Text="{Binding WorktreeBranch, Mode=TwoWay}" />
                                        <Button Classes="primary" Command="{Binding CreateWorktreeCommand}" Content="Create worktree" />
                                        <TextBox PlaceholderText="Exact selected path to confirm removal" Text="{Binding AdvancedConfirmation, Mode=TwoWay}" />
                                        <Button Classes="danger" Command="{Binding RemoveWorktreeCommand}" Content="Remove selected worktree" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Classes="card">
                                    <Grid RowDefinitions="Auto,*,Auto,*" RowSpacing="8">
                                        <TextBlock Classes="h2" Text="Recovery evidence" />
                                        <ListBox Grid.Row="1" MaxHeight="170" ItemsSource="{Binding Reflog}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Classes="mono" Text="{Binding Subject}" TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock Grid.Row="2" Classes="h2" Text="Operation journal" />
                                        <ListBox Grid.Row="3" MaxHeight="170" ItemsSource="{Binding OperationJournal}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Classes="mono muted" Text="{Binding Operation}" />
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <Border
            Grid.Row="1"
            Grid.Column="1"
            Padding="24,8"
            Background="{DynamicResource GitGatSidebarBrush}"
            BorderBrush="{DynamicResource GitGatBorderBrush}"
            BorderThickness="0,1,0,0">
            <TextBlock
                Classes="muted"
                FontSize="11"
                Text="Safe defaults: no force push · no silent untracked deletion · fast-forward-only pull · destructive actions require explicit confirmation" />
        </Border>
    </Grid>
</suki:SukiWindow>
