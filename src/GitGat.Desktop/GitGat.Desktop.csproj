<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>GitGat.Desktop</RootNamespace>
    <AssemblyName>GitGat</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <VersionPrefix>0.1.0</VersionPrefix>
    <AssemblyTitle>GitGat</AssemblyTitle>
    <Product>GitGat</Product>
    <Company>GitGat</Company>
    <Description>A calm, safe desktop Git workspace for teams.</Description>
    <ApplicationIcon Condition="$([MSBuild]::IsOSPlatform('Windows'))">Assets\gitgat.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../GitGat.Domain/GitGat.Domain.csproj" />
    <ProjectReference Include="../GitGat.Application/GitGat.Application.csproj" />
    <ProjectReference Include="../GitGat.Infrastructure/GitGat.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="SukiUI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
  </ItemGroup>
</Project>
