GITGAT_DATABASE_URL=postgres://gitgat:gitgat@127.0.0.1:5432/gitgat
GITGAT_DATABASE_MAX_CONNECTIONS=10
GITGAT_BIND=127.0.0.1:8080
RUST_LOG=gitgat_control_plane=info,tower_http=info

# Production OIDC/JWKS authentication. Configure all three together.
# GITGAT_OIDC_ISSUER=https://identity.example.com/
# GITGAT_OIDC_AUDIENCE=gitgat-control-plane
# GITGAT_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json

# Local development only. The API rejects this mode on non-loopback binds.
# GITGAT_DEV_AUTH_SUBJECT=local-developer
# GITGAT_DEV_AUTH_EMAIL=developer@example.test
# GITGAT_DEV_AUTH_NAME=Local Developer
